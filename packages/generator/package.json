{
  "name": "@appwithai/generator",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "appwithai": "./dist/cli/generate.js",
    "appwithai-generate": "./dist/cli/generate.js",
    "appwithai-wasm": "./dist/cli-wasm/generate.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "dependencies": {
    "@appwithai/core": "workspace:*",
    "@electric-sql/pglite": "^0.5.5",
    "@faker-js/faker": "^10.6.0",
    "commander": "^11.1.0",
    "handlebars": "^4.7.8",
    "node-ssh": "^13.2.1",
    "prettier": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.3",
    "@vitest/coverage-v8": "^1.1.3"
  },
  "scripts": {
    "build": "bun ../../scripts/vendor-editors.ts && bun build src/index.ts src/cli/generate.ts src/cli-wasm/generate.ts --outdir dist --target node --format esm --external @appwithai/core --external handlebars --external commander --external prettier --external node-ssh",
    "generate": "node dist/cli/generate.js generate",
    "dev": "bun run build && bun run generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:wasm": "node dist/cli-wasm/generate.js generate"
  }
}
