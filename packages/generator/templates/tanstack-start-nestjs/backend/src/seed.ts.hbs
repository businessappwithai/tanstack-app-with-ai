/**
 * Database Seed Runner
 * Run with: bun run src/seed.ts
 *
 * Generated: {{now}}
 */

import * as path from 'path';
import * as fs from 'fs';
import { Kysely, PostgresDialect, sql } from 'kysely';
import { Pool } from 'pg';
import { config } from 'dotenv';

import { getLogger } from './common/logging/logger.service';

// Load .env from backend root (parent of src/) regardless of cwd
config({ path: path.join(__dirname, '..', '.env'), override: true });
config({ path: path.join(__dirname, '..', '.env.local'), override: true });

// A script's console output is its report to the person running it, and stays.
// What it also does is name each outcome as a log event, so a migration that
// failed on a server is a line a collector can find. The terminal stays quiet
// about those events unless someone asks (LOG_LEVEL=info).
process.env.LOG_LEVEL ??= 'warn';

async function createDialect(): Promise<PostgresDialect> {
  const url = process.env.DATABASE_URL;
  if (url) {
    return new PostgresDialect({ pool: new Pool({ connectionString: url }) });
  }
  return new PostgresDialect({
    pool: new Pool({
      host: process.env.DB_HOST ?? 'localhost',
      port: Number(process.env.DB_PORT ?? 5432),
      user: process.env.DB_USER ?? 'postgres',
      password: process.env.DB_PASSWORD ?? '',
      database: process.env.DB_NAME ?? '{{snakeCase project.name}}',
    }),
  });
}

async function runSeeds(db: Kysely<any>) {
  const seedDir = path.join(__dirname, '..', 'seeds');
  const files = (await fs.promises.readdir(seedDir))
    .filter(f => f.endsWith('.ts') && !f.endsWith('.bak'))
    .sort();

  for (const file of files) {
    const seedPath = path.join(seedDir, file);
    const seedModule = await import(seedPath);

    if (seedModule.seed) {
      try {
        console.log(`Running seed: ${file}`);
        const startedAt = Date.now();
        await seedModule.seed(db);
        console.log(`✓ Seed "${file}" completed`);
        getLogger('db').event('db.seed.completed', { name: file, durationMs: Date.now() - startedAt });
      } catch (error) {
        console.error(`✗ Seed "${file}" failed:`, error);
        getLogger('db').event('db.seed.failed', { name: file, err: error });
        throw error;
      }
    }
  }

  // The dictionary's allowed_roles column is derived from sys_access, and a
  // trigger keeps it current as grants are written. Seeds also insert windows,
  // tabs and fields *after* the grants that cover them, so those rows would be
  // left unscoped — and a row with no role attached syncs to nobody. One
  // recompute at the end settles the whole dictionary.
  await sql`SELECT sys_refresh_dictionary_scope()`.execute(db);
  console.log('✓ Dictionary role scope refreshed');
}

(async () => {
  const dialect = await createDialect();
  const db = new Kysely<any>({ dialect });

  try {
    await runSeeds(db);
    console.log('✓ Seed initialization completed');
  } catch (error) {
    console.error('Seeding failed:', error);
    process.exit(1);
  } finally {
    await db.destroy();
  }
})().catch((error) => {
  console.error('Fatal error:', error);
  process.exit(1);
});
