{
  "name": "{{kebabCase project.name}}-frontend",
  "version": "{{project.version}}",
  "description": "{{project.description}} - TanStack Start Frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "HOST=127.0.0.1 bun --bun vinxi dev --port {{config.frontendPort}}",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vinxi build",
    "start": "PORT={{config.frontendPort}} bun --bun vinxi start",
    "routes:generate": "bun --bun tsr generate",
    "pretype-check": "bun run routes:generate",
    "type-check": "bun check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
