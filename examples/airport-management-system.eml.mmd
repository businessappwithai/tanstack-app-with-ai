%%report movement-board title: Movement board entity: Flight help: Review dated movement timings for the operations duty briefing. sql: SELECT reference, direction, scheduled_at, estimated_at, actual_at, status FROM bus_flight WHERE deleted_at IS NULL ORDER BY scheduled_at
%%report resource-reservations title: Confirmed facility reservations entity: Allocation help: Review the live reservations requiring resource coordination. sql: SELECT reference, resource_id, flight_id, starts_at, ends_at FROM bus_allocation WHERE status = 'reserved' AND deleted_at IS NULL ORDER BY starts_at
%%report ground-work title: Unfinished handling tasks entity: TurnaroundTask help: Dispatch the ground work still requiring completion. sql: SELECT reference, flight_id, owner_id, due_at FROM bus_turnaround_task WHERE status IN ('queued', 'underway') AND deleted_at IS NULL ORDER BY due_at
%%report baggage-discrepancies title: Unresolved baggage counts entity: BaggageBatch help: Investigate batches whose physical count cannot yet be accepted. sql: SELECT reference, flight_id, expected_bags, counted_bags FROM bus_baggage_batch WHERE (expected_bags <> counted_bags OR status = 'exception') AND deleted_at IS NULL
%%report cargo-holds title: Held cargo consignments entity: CargoConsignment help: Locate consignments that cannot yet leave controlled custody. sql: SELECT reference, flight_id, pieces, weight_kg FROM bus_cargo_consignment WHERE status = 'held' AND deleted_at IS NULL
%%report engineering-backlog title: Maintenance work awaiting handback entity: WorkOrder help: Prioritise equipment repairs still awaiting verified handback. sql: SELECT reference, asset_id, priority, due_at FROM bus_work_order WHERE status <> 'closed' AND deleted_at IS NULL ORDER BY due_at
%%report safety-followup title: Unverified safety commitments entity: CorrectiveAction help: Follow up the owners of unfinished safety commitments. sql: SELECT reference, safety_case_id, owner_id, due_at FROM bus_corrective_action WHERE status <> 'validated' AND deleted_at IS NULL ORDER BY due_at
%%report pass-register title: Issued airside access passes entity: SecurityPass help: Review issued authorisations by expiry before checking current validity. sql: SELECT reference, holder_name, access_zone, valid_until FROM bus_security_pass WHERE status = 'issued' AND deleted_at IS NULL ORDER BY valid_until
%%report outstanding-invoices title: Issued invoices awaiting payment entity: Invoice help: Prioritise airline collection work by payment deadline. sql: SELECT reference, airline_id, due_on, currency, total_amount, received_amount, total_amount - received_amount AS outstanding FROM bus_invoice WHERE status = 'issued' AND deleted_at IS NULL ORDER BY due_on
%%report charge-review title: Airport charges awaiting review entity: Charge help: Resolve assessments and disputes before issuing the next airline bill. sql: SELECT reference, flight_id, currency, gross_amount FROM bus_charge WHERE status IN ('assessed', 'disputed') AND deleted_at IS NULL
%%report airport-created-per-month title: Airports created per month entity: Airport chart: line x: month y: records help: An airport operated by this organisation. New airports per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_airport WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report airport-is-active-share title: Airports: is active entity: Airport chart: pie x: is_active y: records help: An airport operated by this organisation. The share of airports where is active holds against those where it does not. sql: SELECT CASE WHEN is_active THEN 'yes' ELSE 'no' END AS is_active, COUNT(*) AS records FROM bus_airport WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report airport-top-country-code title: Airports: the most common country code entity: Airport chart: bar x: country_code y: records help: An airport operated by this organisation. The ten most frequent values of country code among airports; free text that repeats is a list the model could close. sql: SELECT COALESCE(country_code, '(blank)') AS country_code, COUNT(*) AS records FROM bus_airport WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report staff-by-discipline title: Staffs by discipline entity: Staff chart: bar x: discipline y: records help: An operational employee who owns tasks or approves work. How staffs divide across discipline, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(discipline::text, '(unset)') AS discipline, COUNT(*) AS records FROM bus_staff WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report staff-created-per-month title: Staffs created per month entity: Staff chart: line x: month y: records help: An operational employee who owns tasks or approves work. New staffs per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_staff WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report staff-per-airport title: Staffs per airport entity: Staff chart: bar x: airport y: records help: An operational employee who owns tasks or approves work. Which airport the most staffs belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS airport, COUNT(*) AS records FROM bus_staff x LEFT JOIN bus_airport p ON p.id = x.airport_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report airline-created-per-month title: Airlines created per month entity: Airline chart: line x: month y: records help: An aircraft operator billed for airport services. New airlines per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_airline WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report airline-age-bands title: How recently airlines were changed entity: Airline chart: bar x: last_changed y: records help: An aircraft operator billed for airport services. Records by time since their last change; the oldest band is the stale tail to review or retire. sql: SELECT CASE WHEN updated_at >= now() - interval '30 days' THEN 'last 30 days' WHEN updated_at >= now() - interval '90 days' THEN '30 to 90 days' WHEN updated_at >= now() - interval '180 days' THEN '90 to 180 days' ELSE 'older than 180 days' END AS last_changed, COUNT(*) AS records FROM bus_airline WHERE deleted_at IS NULL GROUP BY 1 ORDER BY MIN(updated_at) DESC
%%report airline-is-active-share title: Airlines: is active entity: Airline chart: pie x: is_active y: records help: An aircraft operator billed for airport services. The share of airlines where is active holds against those where it does not. sql: SELECT CASE WHEN is_active THEN 'yes' ELSE 'no' END AS is_active, COUNT(*) AS records FROM bus_airline WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report aircraft-type-by-wake-category title: Aircraft Types by wake category entity: AircraftType chart: pie x: wake_category y: records help: A certified airframe variant used to check stand suitability and describe the operating fleet. How aircraft types divide across wake category, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(wake_category::text, '(unset)') AS wake_category, COUNT(*) AS records FROM bus_aircraft_type WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report aircraft-type-wingspan-m-by-wake-category title: Total wingspan m by wake category entity: AircraftType chart: bar x: wake_category y: total_wingspan_m help: A certified airframe variant used to check stand suitability and describe the operating fleet. Aircraft Types added up on wingspan m, split by wake category, to show where the quantity sits. sql: SELECT COALESCE(wake_category::text, '(unset)') AS wake_category, ROUND(SUM(wingspan_m)::numeric, 2) AS total_wingspan_m FROM bus_aircraft_type WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC NULLS LAST
%%report aircraft-type-wingspan-m-per-month title: Average wingspan m per month entity: AircraftType chart: line x: month y: average_wingspan_m help: A certified airframe variant used to check stand suitability and describe the operating fleet. The average wingspan m of aircraft types created each month, to see whether the typical record is growing or shrinking. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, ROUND(AVG(wingspan_m)::numeric, 2) AS average_wingspan_m FROM bus_aircraft_type WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report aircraft-type-largest-by-wingspan-m title: The ten largest aircraft types by wingspan m entity: AircraftType chart: bar x: record y: wingspan_m help: A certified airframe variant used to check stand suitability and describe the operating fleet. The records with the highest wingspan m; worth reading for outliers and for the few that carry most of the total. sql: SELECT name::text AS record, wingspan_m FROM bus_aircraft_type WHERE deleted_at IS NULL AND wingspan_m IS NOT NULL ORDER BY wingspan_m DESC LIMIT 10
%%report aircraft-type-passenger-capacity-by-wake-category title: Total passenger capacity by wake category entity: AircraftType chart: bar x: wake_category y: total_passenger_capacity help: A certified airframe variant used to check stand suitability and describe the operating fleet. Aircraft Types added up on passenger capacity, split by wake category, to show where the quantity sits. sql: SELECT COALESCE(wake_category::text, '(unset)') AS wake_category, ROUND(SUM(passenger_capacity)::numeric, 2) AS total_passenger_capacity FROM bus_aircraft_type WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC NULLS LAST
%%report aircraft-type-passenger-capacity-per-month title: Average passenger capacity per month entity: AircraftType chart: line x: month y: average_passenger_capacity help: A certified airframe variant used to check stand suitability and describe the operating fleet. The average passenger capacity of aircraft types created each month, to see whether the typical record is growing or shrinking. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, ROUND(AVG(passenger_capacity)::numeric, 2) AS average_passenger_capacity FROM bus_aircraft_type WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report aircraft-type-largest-by-passenger-capacity title: The ten largest aircraft types by passenger capacity entity: AircraftType chart: bar x: record y: passenger_capacity help: A certified airframe variant used to check stand suitability and describe the operating fleet. The records with the highest passenger capacity; worth reading for outliers and for the few that carry most of the total. sql: SELECT name::text AS record, passenger_capacity FROM bus_aircraft_type WHERE deleted_at IS NULL AND passenger_capacity IS NOT NULL ORDER BY passenger_capacity DESC LIMIT 10
%%report aircraft-type-maximum-takeoff-weight-kg-by-wake-category title: Total maximum takeoff weight kg by wake category entity: AircraftType chart: bar x: wake_category y: total_maximum_takeoff_weight_kg help: A certified airframe variant used to check stand suitability and describe the operating fleet. Aircraft Types added up on maximum takeoff weight kg, split by wake category, to show where the quantity sits. sql: SELECT COALESCE(wake_category::text, '(unset)') AS wake_category, ROUND(SUM(maximum_takeoff_weight_kg)::numeric, 2) AS total_maximum_takeoff_weight_kg FROM bus_aircraft_type WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC NULLS LAST
%%report aircraft-type-maximum-takeoff-weight-kg-per-month title: Average maximum takeoff weight kg per month entity: AircraftType chart: line x: month y: average_maximum_takeoff_weight_kg help: A certified airframe variant used to check stand suitability and describe the operating fleet. The average maximum takeoff weight kg of aircraft types created each month, to see whether the typical record is growing or shrinking. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, ROUND(AVG(maximum_takeoff_weight_kg)::numeric, 2) AS average_maximum_takeoff_weight_kg FROM bus_aircraft_type WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report aircraft-type-largest-by-maximum-takeoff-weight-kg title: The ten largest aircraft types by maximum takeoff weight kg entity: AircraftType chart: bar x: record y: maximum_takeoff_weight_kg help: A certified airframe variant used to check stand suitability and describe the operating fleet. The records with the highest maximum takeoff weight kg; worth reading for outliers and for the few that carry most of the total. sql: SELECT name::text AS record, maximum_takeoff_weight_kg FROM bus_aircraft_type WHERE deleted_at IS NULL AND maximum_takeoff_weight_kg IS NOT NULL ORDER BY maximum_takeoff_weight_kg DESC LIMIT 10
%%report aircraft-created-per-month title: Aircrafts created per month entity: Aircraft chart: line x: month y: records help: A registered airframe visiting the airport. New aircrafts per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_aircraft WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report aircraft-per-aircraft-type title: Aircrafts per aircraft type entity: Aircraft chart: bar x: aircraft_type y: records help: A registered airframe visiting the airport. Which aircraft type the most aircrafts belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS aircraft_type, COUNT(*) AS records FROM bus_aircraft x LEFT JOIN bus_aircraft_type p ON p.id = x.aircraft_type_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report aircraft-per-airline title: Aircrafts per airline entity: Aircraft chart: bar x: airline y: records help: A registered airframe visiting the airport. Which airline the most aircrafts belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS airline, COUNT(*) AS records FROM bus_aircraft x LEFT JOIN bus_airline p ON p.id = x.airline_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report terminal-created-per-month title: Terminals created per month entity: Terminal chart: line x: month y: records help: A passenger building whose gates, counters and reclaim belts are allocated to movements. New terminals per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_terminal WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report terminal-is-active-share title: Terminals: is active entity: Terminal chart: pie x: is_active y: records help: A passenger building whose gates, counters and reclaim belts are allocated to movements. The share of terminals where is active holds against those where it does not. sql: SELECT CASE WHEN is_active THEN 'yes' ELSE 'no' END AS is_active, COUNT(*) AS records FROM bus_terminal WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report terminal-per-airport title: Terminals per airport entity: Terminal chart: bar x: airport y: records help: A passenger building whose gates, counters and reclaim belts are allocated to movements. Which airport the most terminals belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS airport, COUNT(*) AS records FROM bus_terminal x LEFT JOIN bus_airport p ON p.id = x.airport_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report resource-by-resource-type title: Resources by resource type entity: Resource chart: pie x: resource_type y: records help: A schedulable airport facility such as a runway, stand, gate, check-in counter or reclaim belt. How resources divide across resource type, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(resource_type::text, '(unset)') AS resource_type, COUNT(*) AS records FROM bus_resource WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report resource-by-availability title: Resources by availability entity: Resource chart: pie x: availability y: records help: A schedulable airport facility such as a runway, stand, gate, check-in counter or reclaim belt. How resources divide across availability, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(availability::text, '(unset)') AS availability, COUNT(*) AS records FROM bus_resource WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report resource-maximum-wingspan-m-by-resource-type title: Total maximum wingspan m by resource type entity: Resource chart: bar x: resource_type y: total_maximum_wingspan_m help: A schedulable airport facility such as a runway, stand, gate, check-in counter or reclaim belt. Resources added up on maximum wingspan m, split by resource type, to show where the quantity sits. sql: SELECT COALESCE(resource_type::text, '(unset)') AS resource_type, ROUND(SUM(maximum_wingspan_m)::numeric, 2) AS total_maximum_wingspan_m FROM bus_resource WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC NULLS LAST
%%report resource-maximum-wingspan-m-per-month title: Average maximum wingspan m per month entity: Resource chart: line x: month y: average_maximum_wingspan_m help: A schedulable airport facility such as a runway, stand, gate, check-in counter or reclaim belt. The average maximum wingspan m of resources created each month, to see whether the typical record is growing or shrinking. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, ROUND(AVG(maximum_wingspan_m)::numeric, 2) AS average_maximum_wingspan_m FROM bus_resource WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report resource-largest-by-maximum-wingspan-m title: The ten largest resources by maximum wingspan m entity: Resource chart: bar x: record y: maximum_wingspan_m help: A schedulable airport facility such as a runway, stand, gate, check-in counter or reclaim belt. The records with the highest maximum wingspan m; worth reading for outliers and for the few that carry most of the total. sql: SELECT name::text AS record, maximum_wingspan_m FROM bus_resource WHERE deleted_at IS NULL AND maximum_wingspan_m IS NOT NULL ORDER BY maximum_wingspan_m DESC LIMIT 10
%%report resource-capacity-by-resource-type title: Total capacity by resource type entity: Resource chart: bar x: resource_type y: total_capacity help: A schedulable airport facility such as a runway, stand, gate, check-in counter or reclaim belt. Resources added up on capacity, split by resource type, to show where the quantity sits. sql: SELECT COALESCE(resource_type::text, '(unset)') AS resource_type, ROUND(SUM(capacity)::numeric, 2) AS total_capacity FROM bus_resource WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC NULLS LAST
%%report resource-capacity-per-month title: Average capacity per month entity: Resource chart: line x: month y: average_capacity help: A schedulable airport facility such as a runway, stand, gate, check-in counter or reclaim belt. The average capacity of resources created each month, to see whether the typical record is growing or shrinking. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, ROUND(AVG(capacity)::numeric, 2) AS average_capacity FROM bus_resource WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report resource-largest-by-capacity title: The ten largest resources by capacity entity: Resource chart: bar x: record y: capacity help: A schedulable airport facility such as a runway, stand, gate, check-in counter or reclaim belt. The records with the highest capacity; worth reading for outliers and for the few that carry most of the total. sql: SELECT name::text AS record, capacity FROM bus_resource WHERE deleted_at IS NULL AND capacity IS NOT NULL ORDER BY capacity DESC LIMIT 10
%%report resource-per-airport title: Resources per airport entity: Resource chart: bar x: airport y: records help: A schedulable airport facility such as a runway, stand, gate, check-in counter or reclaim belt. Which airport the most resources belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS airport, COUNT(*) AS records FROM bus_resource x LEFT JOIN bus_airport p ON p.id = x.airport_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report resource-maximum-wingspan-m-per-airport title: Total maximum wingspan m per airport entity: Resource chart: bar x: airport y: total_maximum_wingspan_m help: A schedulable airport facility such as a runway, stand, gate, check-in counter or reclaim belt. Resources added up on maximum wingspan m for each airport, ten largest first. sql: SELECT COALESCE(p.name::text, '(none)') AS airport, ROUND(SUM(x.maximum_wingspan_m)::numeric, 2) AS total_maximum_wingspan_m FROM bus_resource x LEFT JOIN bus_airport p ON p.id = x.airport_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC NULLS LAST LIMIT 10
%%report resource-per-terminal title: Resources per terminal entity: Resource chart: bar x: terminal y: records help: A schedulable airport facility such as a runway, stand, gate, check-in counter or reclaim belt. Which terminal the most resources belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS terminal, COUNT(*) AS records FROM bus_resource x LEFT JOIN bus_terminal p ON p.id = x.terminal_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report resource-maximum-wingspan-m-per-terminal title: Total maximum wingspan m per terminal entity: Resource chart: bar x: terminal y: total_maximum_wingspan_m help: A schedulable airport facility such as a runway, stand, gate, check-in counter or reclaim belt. Resources added up on maximum wingspan m for each terminal, ten largest first. sql: SELECT COALESCE(p.name::text, '(none)') AS terminal, ROUND(SUM(x.maximum_wingspan_m)::numeric, 2) AS total_maximum_wingspan_m FROM bus_resource x LEFT JOIN bus_terminal p ON p.id = x.terminal_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC NULLS LAST LIMIT 10
%%report flight-by-status title: Flights by status entity: Flight chart: pie x: status y: records help: One arrival or departure at one operated airport on a service date. How flights divide across status, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(status::text, '(unset)') AS status, COUNT(*) AS records FROM bus_flight WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report flight-by-direction title: Flights by direction entity: Flight chart: pie x: direction y: records help: One arrival or departure at one operated airport on a service date. How flights divide across direction, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(direction::text, '(unset)') AS direction, COUNT(*) AS records FROM bus_flight WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report flight-lifecycle title: Flight lifecycle entity: Flight chart: bar x: state y: records help: One arrival or departure at one operated airport on a service date. Where flights sit in their state machine, in the order the diagram draws it; a state nothing has reached shows as zero. sql: SELECT d.state, COALESCE(c.records, 0) AS records FROM (SELECT 'planned' AS state, 0 AS position UNION ALL SELECT 'scheduled', 1 UNION ALL SELECT 'cancelled', 2 UNION ALL SELECT 'active', 3 UNION ALL SELECT 'completed', 4) d LEFT JOIN (SELECT status AS state, COUNT(*) AS records FROM bus_flight WHERE deleted_at IS NULL GROUP BY 1) c ON c.state = d.state ORDER BY d.position
%%report flight-passenger-count-by-status title: Total passenger count by status entity: Flight chart: bar x: status y: total_passenger_count help: One arrival or departure at one operated airport on a service date. Flights added up on passenger count, split by status, to show where the quantity sits. sql: SELECT COALESCE(status::text, '(unset)') AS status, ROUND(SUM(passenger_count)::numeric, 2) AS total_passenger_count FROM bus_flight WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC NULLS LAST
%%report flight-passenger-count-per-month title: Average passenger count per month entity: Flight chart: line x: month y: average_passenger_count help: One arrival or departure at one operated airport on a service date. The average passenger count of flights created each month, to see whether the typical record is growing or shrinking. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, ROUND(AVG(passenger_count)::numeric, 2) AS average_passenger_count FROM bus_flight WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report flight-largest-by-passenger-count title: The ten largest flights by passenger count entity: Flight chart: bar x: record y: passenger_count help: One arrival or departure at one operated airport on a service date. The records with the highest passenger count; worth reading for outliers and for the few that carry most of the total. sql: SELECT reference::text AS record, passenger_count FROM bus_flight WHERE deleted_at IS NULL AND passenger_count IS NOT NULL ORDER BY passenger_count DESC LIMIT 10
%%report flight-per-airport title: Flights per airport entity: Flight chart: bar x: airport y: records help: One arrival or departure at one operated airport on a service date. Which airport the most flights belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS airport, COUNT(*) AS records FROM bus_flight x LEFT JOIN bus_airport p ON p.id = x.airport_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report allocation-by-status title: Allocations by status entity: Allocation chart: pie x: status y: records help: A timed reservation of one airport resource for one movement. How allocations divide across status, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(status::text, '(unset)') AS status, COUNT(*) AS records FROM bus_allocation WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report allocation-lifecycle title: Allocation lifecycle entity: Allocation chart: bar x: state y: records help: A timed reservation of one airport resource for one movement. Where allocations sit in their state machine, in the order the diagram draws it; a state nothing has reached shows as zero. sql: SELECT d.state, COALESCE(c.records, 0) AS records FROM (SELECT 'requested' AS state, 0 AS position UNION ALL SELECT 'reserved', 1 UNION ALL SELECT 'voided', 2 UNION ALL SELECT 'released', 3) d LEFT JOIN (SELECT status AS state, COUNT(*) AS records FROM bus_allocation WHERE deleted_at IS NULL GROUP BY 1) c ON c.state = d.state ORDER BY d.position
%%report allocation-per-flight title: Allocations per flight entity: Allocation chart: bar x: flight y: records help: A timed reservation of one airport resource for one movement. Which flight the most allocations belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.reference::text, '(none)') AS flight, COUNT(*) AS records FROM bus_allocation x LEFT JOIN bus_flight p ON p.id = x.flight_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report service-provider-created-per-month title: Service Providers created per month entity: ServiceProvider chart: line x: month y: records help: A contracted ground service organisation assigned turnaround work or maintaining airport assets. New service providers per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_service_provider WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report service-provider-age-bands title: How recently service providers were changed entity: ServiceProvider chart: bar x: last_changed y: records help: A contracted ground service organisation assigned turnaround work or maintaining airport assets. Records by time since their last change; the oldest band is the stale tail to review or retire. sql: SELECT CASE WHEN updated_at >= now() - interval '30 days' THEN 'last 30 days' WHEN updated_at >= now() - interval '90 days' THEN '30 to 90 days' WHEN updated_at >= now() - interval '180 days' THEN '90 to 180 days' ELSE 'older than 180 days' END AS last_changed, COUNT(*) AS records FROM bus_service_provider WHERE deleted_at IS NULL GROUP BY 1 ORDER BY MIN(updated_at) DESC
%%report service-provider-is-active-share title: Service Providers: is active entity: ServiceProvider chart: pie x: is_active y: records help: A contracted ground service organisation assigned turnaround work or maintaining airport assets. The share of service providers where is active holds against those where it does not. sql: SELECT CASE WHEN is_active THEN 'yes' ELSE 'no' END AS is_active, COUNT(*) AS records FROM bus_service_provider WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report turnaround-task-by-status title: Turnaround Tasks by status entity: TurnaroundTask chart: pie x: status y: records help: An independently assignable piece of ground work for a movement, tracked until completion or exception. How turnaround tasks divide across status, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(status::text, '(unset)') AS status, COUNT(*) AS records FROM bus_turnaround_task WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report turnaround-task-by-service-type title: Turnaround Tasks by service type entity: TurnaroundTask chart: bar x: service_type y: records help: An independently assignable piece of ground work for a movement, tracked until completion or exception. How turnaround tasks divide across service type, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(service_type::text, '(unset)') AS service_type, COUNT(*) AS records FROM bus_turnaround_task WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report turnaround-task-lifecycle title: Turnaround Task lifecycle entity: TurnaroundTask chart: bar x: state y: records help: An independently assignable piece of ground work for a movement, tracked until completion or exception. Where turnaround tasks sit in their state machine, in the order the diagram draws it; a state nothing has reached shows as zero. sql: SELECT d.state, COALESCE(c.records, 0) AS records FROM (SELECT 'queued' AS state, 0 AS position UNION ALL SELECT 'underway', 1 UNION ALL SELECT 'waived', 2 UNION ALL SELECT 'finished', 3) d LEFT JOIN (SELECT status AS state, COUNT(*) AS records FROM bus_turnaround_task WHERE deleted_at IS NULL GROUP BY 1) c ON c.state = d.state ORDER BY d.position
%%report baggage-batch-by-status title: Baggage Batches by status entity: BaggageBatch chart: pie x: status y: records help: An aggregate hold-baggage batch on a movement. How baggage batches divide across status, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(status::text, '(unset)') AS status, COUNT(*) AS records FROM bus_baggage_batch WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report baggage-batch-lifecycle title: Baggage Batch lifecycle entity: BaggageBatch chart: bar x: state y: records help: An aggregate hold-baggage batch on a movement. Where baggage batches sit in their state machine, in the order the diagram draws it; a state nothing has reached shows as zero. sql: SELECT d.state, COALESCE(c.records, 0) AS records FROM (SELECT 'collecting' AS state, 0 AS position UNION ALL SELECT 'reconciled', 1 UNION ALL SELECT 'exception', 2 UNION ALL SELECT 'loaded', 3 UNION ALL SELECT 'delivered', 4) d LEFT JOIN (SELECT status AS state, COUNT(*) AS records FROM bus_baggage_batch WHERE deleted_at IS NULL GROUP BY 1) c ON c.state = d.state ORDER BY d.position
