%%workflow AmbulanceTripLifecycle entity: AmbulanceTrip kind: state
stateDiagram-v2
[*] --> requested
requested --> dispatched : advance
dispatched --> arrived : advance
arrived --> transporting : advance
transporting --> completed : advance
completed --> cancelled : advance
requested --> cancelled : cancel
cancelled --> [*]
%%rbac role:dispatcher|paramedic|nurse on AmbulanceTrip.advance
%%rbac role:dispatcher|paramedic|nurse on AmbulanceTrip.cancel
