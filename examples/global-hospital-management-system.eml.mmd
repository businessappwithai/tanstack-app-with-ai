%%meta name: Hospital Safety Rules
%%meta kind: rules
%%rule medicationAdministrationSafety on MedicationAdministration event: beforeUpdate priority: 10
flowchart TD
A([Administration requested]) --> B{status == given?}
B -->|Yes| C[Require verified dose and time]
B -->|No| D[Record outcome reason]
C --> Z([Decision complete])
D --> Z
%%action requireDose validation-error when: dose_given == null message: A given medication must record the actual dose.
%%meta name: Admission Discharge Orchestration
%%meta kind: workflow
%%workflow AdmissionDischarge entity: Admission kind: saga
flowchart TD
A([Discharge approved]) --> B[Set discharge marker]
B --> C[Close admission]
C --> Z([Discharged])
%%step B Formula target: dischargeMarker operation: set value: approved
%%step C UpdateEntity field: status value: discharged
%%meta name: Patient Tenant Scope
%%meta kind: workflow
%%workflow PatientTenantScope entity: Patient kind: hook
flowchart TD
A[Query requested] --> B[Apply tenant scope]
B --> C[Return authorized rows]
%%hook beforeQuery enforceTenantScope on Patient[field: tenant_id]
